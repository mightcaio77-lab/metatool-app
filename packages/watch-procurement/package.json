{
  "name": "@repo/watch-procurement",
  "version": "1.0.0",
  "description": "MCP server for procuring watches below market price on OLX and Enjoei",
  "type": "module",
  "bin": {
    "watch-procurement": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.16.0",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^20.0.0",
    "eslint": "^9.28.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.0.0"
  },
  "keywords": ["mcp", "relogio", "olx", "enjoei", "watch", "procurement"]
}
